# Copy this file to ".env" (same folder) and fill in your keys.
# Save .env as UTF-8. Never commit .env or paste keys in chat.

TAVILY_API_KEY=

# ---- AI model: choose ONE option --------------------------------------------
# Option A: Anthropic Claude
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Option B: any OpenAI-compatible provider (Google Gemini, OpenAI, Groq, OpenRouter...)
# Set LLM_PROVIDER=openai_compatible and fill the three lines below, e.g. for Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional backup model, tried automatically if the main one is overloaded (HTTP 503)
LLM_FALLBACK_MODEL=

# SQLite for development. For Render/PostgreSQL later, use the DB URL Render gives you.
DATABASE_URL=sqlite:///./meetwise.db

# Comma-separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:3000

ENVIRONMENT=development
LOG_LEVEL=INFO

# true = run the whole app on clearly-labelled demo data (no API keys needed)
MOCK_MODE=false
